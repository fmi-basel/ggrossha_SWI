profiles {
    standard {

        process {
            executor = 'local'

            withLabel: 'cpu' {
                cpus = 2
            }

            withLabel: 'gpu' {
                cpus = 2
            }
        }
    }


    slurm {

        process {
            executor = 'slurm'
            queueSize = 50
            submitRateLimit = '10/2min'
            queue = 'main'

            withLabel: 'cpu' {
                cpus = 16
                memory = '16 GB'
                clusterOptions = '--time=4:00:00 --constraint "infiniband"'
            }
            withLabel: 'gpu' {
                cpus = 12
                memory = '96 GB'
                clusterOptions = '--time=4:00:00 --gres=gpu:a40:1 --constraint "infiniband"'
            }
        }
    }
}
